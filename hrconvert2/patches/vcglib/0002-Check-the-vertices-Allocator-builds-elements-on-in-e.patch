From: Paolo Cignoni <paolo.cignoni@isti.cnr.it>
Date: Sat, 21 Nov 2026 14:53:17 +0100
Subject: [PATCH 02/12] Check the vertices Allocator builds elements on in
 every build

AddFace, AddQuadFace and AddEdge checked that their vertices are the
mesh's only by assertion, and the pointer form of AddEdge not at all: in
a release build an out-of-range index or a foreign pointer gave an
element pointing outside m.vert, and whatever followed it later read and
wrote memory that is not the mesh's. A malformed OFF file reached it this
way. RequireMeshVertex now throws MissingPreconditionException instead,
for indices before &m.vert[i] is formed, and for pointers, compared
through std::less, which orders any two. No correct caller passes such a
vertex, so none changes; the cost is two comparisons a vertex.

The assertion that a face's or an edge's vertices differ stays one:
code that builds degenerate elements on purpose works in release builds.

allocate.h now includes exception.h, as files that include it alone
(filter_mls in MeshLab) do not get it through complex.h.
---
 vcg/complex/allocate.h | 47 +++++++++++++++++++++++++++++-------------
 1 file changed, 33 insertions(+), 14 deletions(-)

diff --git a/vcg/complex/allocate.h b/vcg/complex/allocate.h
index 442366a3..361b1094 100644
--- a/vcg/complex/allocate.h
+++ b/vcg/complex/allocate.h
@@ -23,10 +23,12 @@
 #ifndef __VCGLIB_TRIALLOCATOR
 #define __VCGLIB_TRIALLOCATOR
 
+#include <functional>
 #include <vector>
 #include <set>
 
 #include <vcg/container/simple_temporary_data.h>
+#include <vcg/complex/exception.h>
 
 #include "used_types.h"
 
@@ -382,10 +384,29 @@ public:
     return firstNewEdge;// deve restituire l'iteratore alla prima faccia aggiunta;
   }
 
+  /** Throws unless v points into m.vert. The functions that build an element on given vertices
+      check them always, not only by assertion: a vertex index or pointer that is out of range,
+      such as one read from a malformed file, would otherwise make the element point outside the
+      vector, and anything that later follows it read and write memory that is not the mesh's.
+      Pointers are compared through std::less, which orders any two pointers. */
+  static void RequireMeshVertex(const MeshType &m, const VertexType *v)
+  {
+    const std::less<const VertexType *> before;
+    if (m.vert.empty() || before(v, &m.vert.front()) || before(&m.vert.back(), v))
+      throw vcg::MissingPreconditionException("a vertex outside the mesh's vertex vector");
+  }
+  static void RequireMeshVertex(const MeshType &m, size_t v)
+  {
+    if (v >= m.vert.size())
+      throw vcg::MissingPreconditionException("a vertex index outside the mesh's vertex vector");
+  }
+
   /** Function to add a single edge to the mesh. and initializing it with two VertexPointer
             */
   static EdgeIterator AddEdge(MeshType &m, VertexPointer v0, VertexPointer v1)
   {
+    RequireMeshVertex(m, v0);
+    RequireMeshVertex(m, v1);
     EdgeIterator ei= AddEdges(m, 1);
     ei->V(0)=v0;
     ei->V(1)=v1;
@@ -397,8 +418,8 @@ public:
   static EdgeIterator AddEdge(MeshType &m, size_t v0, size_t v1)
   {
     assert(v0!=v1);
-    assert(v0>=0 && v0<m.vert.size());
-    assert(v1>=0 && v1<m.vert.size());
+    RequireMeshVertex(m, v0);
+    RequireMeshVertex(m, v1);
     return AddEdge(m,&(m.vert[v0]),&(m.vert[v1]));
   }
   
@@ -538,11 +559,10 @@ public:
