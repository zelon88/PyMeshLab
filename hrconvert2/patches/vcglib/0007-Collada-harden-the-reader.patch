From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HRConvert2 <hrconvert2@invalid>
Date: Thu, 26 Nov 2026 22:18:10 -0500
Subject: [PATCH] Collada: harden the reader

---
 wrap/dae/util_dae.h          | 11 ++++--
 wrap/io_trimesh/import_dae.h | 71 ++++++++++++++++++++++++++++--------
 2 files changed, 64 insertions(+), 18 deletions(-)

diff --git a/wrap/dae/util_dae.h b/wrap/dae/util_dae.h
index 431dd143..b837573c 100644
--- a/wrap/dae/util_dae.h
+++ b/wrap/dae/util_dae.h
@@ -245,7 +245,8 @@ namespace io {
 				QString rt = t[ii].firstChild().nodeValue();
 				QStringList rtl = rt.split(" ");
 				if (rtl.last() == "") rtl.removeLast();
-				assert(rtl.size() == 4);
+				// A rotation with fewer than four values is left out, as reading it would run past the list.
+				if (rtl.size() < 4) continue;
 				tmp.SetRotateDeg(rtl.at(3).toFloat(),vcg::Point3f(rtl.at(0).toFloat(),rtl.at(1).toFloat(),rtl.at(2).toFloat()));
 				rotTmp = rotTmp*tmp;	
 			}
@@ -260,7 +261,9 @@ namespace io {
 			QStringList coordlist = coord.split(" ");
 			if (coordlist.last() == "") 
 				coordlist.removeLast();
-			assert(coordlist.size() == 3);
+			// A translation with fewer than three values is left out, as reading it would run past the list.
+			if (coordlist.size() < 3)
+				return;
 			m[0][0] = 1.0f;
 			m[1][1] = 1.0f;
 			m[2][2] = 1.0f;
@@ -279,7 +282,9 @@ namespace io {
 			QStringList coordlist = coord.split(" ");
 			if (coordlist.last() == "") 
 				coordlist.removeLast();
-			assert(coordlist.size() == 16);
+			// A matrix with fewer than sixteen values is left out, as reading it would run past the list.
+			if (coordlist.size() < 16)
+				return;
 			for(int i=0;i<4;++i)
 			{
 				m[i][0] = coordlist.at(i*4+0).toFloat();
diff --git a/wrap/io_trimesh/import_dae.h b/wrap/io_trimesh/import_dae.h
