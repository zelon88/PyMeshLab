                 m.face[meshfaceind].WT(component) = vcg::TexCoord2<float>();
                 m.face[meshfaceind].WT(component).U() = wt.at(indtx * stride).toFloat();
                 m.face[meshfaceind].WT(component).V() = wt.at(indtx * stride + 1).toFloat();
@@ -109,9 +111,10 @@ namespace io {
