+// The rest of a header line after its keyword. strtok replaced the separator after the keyword
+// with a terminator, unless the keyword ended the line, & then nothing follows it.
+static std::string RestOfHeaderLine( const char * token, const char * lineEnd )
+{
+	const char * rest = token + strlen(token);
+	if( rest < lineEnd ) ++rest;
+	return std::string(rest);
+}
