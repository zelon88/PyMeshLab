 const int SKIP_MAX_BUF = 512;
 
+// A list stored in place, rather than in memory allocated for it, goes into an array of the
+// importer's. A binary list's count is one byte, so an importer's array holds 255 entries, & a
+// list whose count is read as an int, as an ascii list's always is, is refused past that.
+const int MAX_INPLACE_LIST = 255;
+
 // Discard one binary list property: a uchar count followed by n elements of
 // elemSize bytes. The count reaches 255, so a single pb_fread of n*elemSize bytes
 // overruns skip_buf as soon as the list is longer than SKIP_MAX_BUF/elemSize --
@@ -1930,6 +1959,7 @@ static bool cb_read_list_ascii( GZFILE fp, void * mem, PropDescriptor * d )
 	int i,n;
 
 	if( ReadIntA(fp,&n)==0) return false;
+	if( n<0 || (!d->alloclist && n>MAX_INPLACE_LIST) ) return false;
 
 		// Lettura con memorizzazione
 	char * store;
@@ -1939,7 +1969,7 @@ static bool cb_read_list_ascii( GZFILE fp, void * mem, PropDescriptor * d )
 	if(d->alloclist)
 	{
 		store = (char *)calloc(n,TypeSize[d->memtype1]);
-		assert(store);
+		if( n>0 && store==0 ) return false;
 		*(char **)(((char *)mem)+d->offset1) = store;
 	}
 	else
@@ -2399,12 +2429,13 @@ static bool cb_read_list_inin( GZFILE fp, void * mem, PropDescriptor * d )
