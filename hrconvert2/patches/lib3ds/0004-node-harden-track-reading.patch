From: HRConvert2 <hrconvert2@invalid>
Date: Thu, 26 Nov 2026 22:06:28 -0500
Subject: [PATCH] node: harden track reading

---
 lib3ds/node.c | 54 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/lib3ds/node.c b/lib3ds/node.c
index 822bfd9..84b3bb8 100644
--- a/lib3ds/node.c
+++ b/lib3ds/node.c
@@ -481,6 +481,56 @@ lib3ds_node_dump(Lib3dsNode *node, Lib3dsIntd level)
 }
 
 
+/*
+ * A track's chunk holds a flags word, two dwords & its key count, then its keys, each at least the bytes
+ * of a frame, a flags word & its value. The count is read ahead & held to the keys the chunk, which ends at
+ * end, could hold at their smallest, so a count the file makes up cannot have a track's reader make more
+ * keys than the file has bytes for.
+ */
+static Lib3dsBool
+track_keys_fit(Lib3dsWord chunk, Lib3dsIo *io, Lib3dsDword end)
+{
+  Lib3dsDword key_bytes;
+  Lib3dsDword keys;
+  long start;
+  Lib3dsBool fits;
+
+  switch (chunk) {
+    case LIB3DS_COL_TRACK_TAG:
+    case LIB3DS_POS_TRACK_TAG:
+    case LIB3DS_SCL_TRACK_TAG:
+      key_bytes=18;
+      break;
+    case LIB3DS_ROT_TRACK_TAG:
+      key_bytes=22;
+      break;
+    case LIB3DS_FOV_TRACK_TAG:
+    case LIB3DS_HOT_TRACK_TAG:
+    case LIB3DS_FALL_TRACK_TAG:
+    case LIB3DS_ROLL_TRACK_TAG:
+      key_bytes=10;
+      break;
+    case LIB3DS_HIDE_TRACK_TAG:
+      key_bytes=6;
+      break;
+    case LIB3DS_MORPH_TRACK_TAG:
+      key_bytes=7;
+      break;
+    default:
+      return(LIB3DS_TRUE);
+  }
+  start=lib3ds_io_tell(io);
+  if ((start<0) || ((Lib3dsDword)start>end) || (end-(Lib3dsDword)start<14)) {
+    return(LIB3DS_FALSE);
+  }
+  lib3ds_io_seek(io, start+10, LIB3DS_SEEK_SET);
+  keys=lib3ds_io_read_dword(io);
+  fits=(keys<=(end-(Lib3dsDword)start-14)/key_bytes);
+  lib3ds_io_seek(io, start, LIB3DS_SEEK_SET);
+  return(fits);
+}
+
+
 /*!
  * \ingroup node
  */
@@ -508,6 +558,10 @@ lib3ds_node_read(Lib3dsNode *node, Lib3dsFile *file, Lib3dsIo *io)
   }
 
   while ((chunk=lib3ds_chunk_read_next(&c, io))!=0) {
+    if (!track_keys_fit(chunk, io, c.cur)) {
+      /* A track that cannot hold its keys is skipped, as an unknown chunk is, & the node keeps its other chunks. */
+      continue;
+    }
     switch (chunk) {
       case LIB3DS_NODE_ID:
         {
