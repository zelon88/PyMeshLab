From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HRConvert2 <hrconvert2@invalid>
Date: Thu, 26 Nov 2026 22:48:03 -0500
Subject: [PATCH] tcb, tracks: harden frame arithmetic

---
 lib3ds/tcb.c    |  6 +++---
 lib3ds/tracks.c | 12 ++++++------
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/lib3ds/tcb.c b/lib3ds/tcb.c
index 160dc30..e861ee1 100644
--- a/lib3ds/tcb.c
+++ b/lib3ds/tcb.c
@@ -48,9 +48,9 @@ lib3ds_tcb(Lib3dsTcb *p, Lib3dsTcb *pc, Lib3dsTcb *c, Lib3dsTcb *nc, Lib3dsTcb *
   
   fp=fn=1.0f;
   if (p&&n) {
-    dt=0.5f*(Lib3dsFloat)(pc->frame-p->frame+n->frame-nc->frame);
-    fp=((Lib3dsFloat)(pc->frame-p->frame))/dt;
-    fn=((Lib3dsFloat)(n->frame-nc->frame))/dt;
+    dt=0.5f*(Lib3dsFloat)((double)pc->frame-(double)p->frame+(double)n->frame-(double)nc->frame);
+    fp=((Lib3dsFloat)((double)pc->frame-(double)p->frame))/dt;
+    fn=((Lib3dsFloat)((double)n->frame-(double)nc->frame))/dt;
     cc=(Lib3dsFloat)fabs(c->cont);
     fp=fp+cc-cc*fp;
     fn=fn+cc-cc*fn;
diff --git a/lib3ds/tracks.c b/lib3ds/tracks.c
index 384a82b..d5d14f1 100644
--- a/lib3ds/tracks.c
+++ b/lib3ds/tracks.c
@@ -473,7 +473,7 @@ lib3ds_lin1_track_eval(Lib3dsLin1Track *track, Lib3dsFloat *p, Lib3dsFloat t)
   }
   if (!k->next) {
     if (track->flags&LIB3DS_REPEAT) {
-      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, k->tcb.frame - track->keyL->tcb.frame) + track->keyL->tcb.frame;
+      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, (double)k->tcb.frame - (double)track->keyL->tcb.frame) + track->keyL->tcb.frame;
       for (k=track->keyL; k->next!=0; k=k->next) {
         if ((nt>=(Lib3dsFloat)k->tcb.frame) && (nt<(Lib3dsFloat)k->next->tcb.frame)) {
           break;
@@ -490,7 +490,7 @@ lib3ds_lin1_track_eval(Lib3dsLin1Track *track, Lib3dsFloat *p, Lib3dsFloat t)
     nt=t;
   }
   u=nt - (Lib3dsFloat)k->tcb.frame;
-  u/=(Lib3dsFloat)(k->next->tcb.frame - k->tcb.frame);
+  u/=(Lib3dsFloat)((double)k->next->tcb.frame - (double)k->tcb.frame);
 
   *p = lib3ds_float_cubic(
     k->value,
@@ -788,7 +788,7 @@ lib3ds_lin3_track_eval(Lib3dsLin3Track *track, Lib3dsVector p, Lib3dsFloat t)
   }
   if (!k->next) {
     if (track->flags&LIB3DS_REPEAT) {
-      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, k->tcb.frame - track->keyL->tcb.frame) + track->keyL->tcb.frame;
+      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, (double)k->tcb.frame - (double)track->keyL->tcb.frame) + track->keyL->tcb.frame;
       for (k=track->keyL; k->next!=0; k=k->next) {
         if ((nt>=(Lib3dsFloat)k->tcb.frame) && (nt<(Lib3dsFloat)k->next->tcb.frame)) {
           break;
@@ -805,7 +805,7 @@ lib3ds_lin3_track_eval(Lib3dsLin3Track *track, Lib3dsVector p, Lib3dsFloat t)
     nt=t;
   }
   u=nt - (Lib3dsFloat)k->tcb.frame;
-  u/=(Lib3dsFloat)(k->next->tcb.frame - k->tcb.frame);
+  u/=(Lib3dsFloat)((double)k->next->tcb.frame - (double)k->tcb.frame);
   
   lib3ds_vector_cubic(
     p,
@@ -1136,7 +1136,7 @@ lib3ds_quat_track_eval(Lib3dsQuatTrack *track, Lib3dsQuat q, Lib3dsFloat t)
   }
   if (!k->next) {
     if (track->flags&LIB3DS_REPEAT) {
-      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, k->tcb.frame - track->keyL->tcb.frame) + track->keyL->tcb.frame;
+      nt=(Lib3dsFloat)fmod(t - track->keyL->tcb.frame, (double)k->tcb.frame - (double)track->keyL->tcb.frame) + track->keyL->tcb.frame;
       for (k=track->keyL; k->next!=0; k=k->next) {
         if ((nt>=k->tcb.frame) && (nt<k->next->tcb.frame)) {
           break;
@@ -1153,7 +1153,7 @@ lib3ds_quat_track_eval(Lib3dsQuatTrack *track, Lib3dsQuat q, Lib3dsFloat t)
     nt=t;
   }
   u=nt - k->tcb.frame;
-  u/=(k->next->tcb.frame - k->tcb.frame);
+  u/=(Lib3dsFloat)((double)k->next->tcb.frame - (double)k->tcb.frame);
 
   lib3ds_quat_squad(
     q,
