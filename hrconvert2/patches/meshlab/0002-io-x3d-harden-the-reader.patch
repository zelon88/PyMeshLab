From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HRConvert2 <hrconvert2@invalid>
Date: Thu, 26 Nov 2026 22:07:22 -0500
Subject: [PATCH] io_x3d: harden the reader

---
 src/meshlabplugins/io_x3d/import_x3d.h | 25 ++++++++++++++++++-------
 1 file changed, 18 insertions(+), 7 deletions(-)

diff --git a/src/meshlabplugins/io_x3d/import_x3d.h b/src/meshlabplugins/io_x3d/import_x3d.h
index bf59454..de63cc0 100644
--- a/src/meshlabplugins/io_x3d/import_x3d.h
+++ b/src/meshlabplugins/io_x3d/import_x3d.h
@@ -918,7 +918,8 @@ namespace io {
 			}
 			
 			std::map<QString, QDomElement> defUse;
-			info->numface += countObject(doc->firstChildElement(), defUse);
+			std::set<QString> counting;
+			info->numface += countObject(doc->firstChildElement(), defUse, counting);
 			//set mask
 			if (bHasPerWedgeTexCoord) 
 				info->mask |= vcg::tri::io::Mask::IOM_WEDGTEXCOORD;
@@ -942,29 +943,39 @@ namespace io {
 		
 
 		//Return the number of x3d object in the scene
-		static int countObject(const QDomElement& root, std::map<QString, QDomElement>& defUse)
+		static int countObject(const QDomElement& root, std::map<QString, QDomElement>& defUse, std::set<QString>& counting)
 		{
 			if (root.isNull()) return 0;
 			int n = 0;
 			if (root.tagName() == "Shape")
 				return ++n;
-			if (root.attribute("DEF") != "")
-				defUse[root.attribute("DEF")] = root;
+			QString def = root.attribute("DEF");
+			if (def != "")
+				defUse[def] = root;
 			else if (root.attribute("USE") != "")
 			{
-				std::map<QString, QDomElement>::const_iterator iter = defUse.find(root.attribute("USE"));
+				QString use = root.attribute("USE");
+				std::map<QString, QDomElement>::const_iterator iter = defUse.find(use);
 				if (iter != defUse.end())
 				{
-					n += countObject(iter->second, defUse);
+					// A USE inside the DEF it names would be counted for ever.
+					if (counting.count(use) != 0)
+						return 0;
+					counting.insert(use);
+					n += countObject(iter->second, defUse, counting);
+					counting.erase(use);
 					return n;
 				}
 			}
+			bool counted = (def != "") && counting.insert(def).second;
 			QDomElement child = root.firstChildElement();
 			while(!child.isNull())
 			{
-				n += countObject(child, defUse);
+				n += countObject(child, defUse, counting);
 				child = child.nextSiblingElement();
 			}
+			if (counted)
+				counting.erase(def);
 			return n;
 		}
 		
